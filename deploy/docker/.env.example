# Copy to .env on the server: cp .env.example .env && nano .env
# Never commit .env.

# Public site URL (used in email links and CORS)
APP_PUBLIC_URL=https://iqadms.iotlab-uphsdm.live

# Host port exposed on pqad (keep 5173 so Cloudflare/tunnel config unchanged)
HTTP_PORT=5173

# Database (bundled postgres container — default)
POSTGRES_DB=iqadms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
# To use Postgres already running on the host instead of the container:
# DB_HOST=host.docker.internal
# DB_PORT=5432
# Then stop/remove the postgres service or use docker-compose.hostdb.yml

# JWT (must match or replace what was on pqad appsettings)
JWT_KEY=replace-with-long-random-secret-at-least-32-chars
JWT_ISSUER=IQADMS
JWT_AUDIENCE=IQADMS

# SMTP (Gmail app password or department mailbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=IQADMS · PQAD
SMTP_ADMIN_EMAIL=
SMTP_FEEDBACK_EMAIL=iqadms.pqad@gmail.com