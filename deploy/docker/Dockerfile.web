# syntax=docker/dockerfile:1
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/iqadms-frontend/package.json frontend/iqadms-frontend/package-lock.json* ./
RUN npm ci
COPY frontend/iqadms-frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/docker/nginx-docker.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O- "http://127.0.0.1:5173/login" | grep -qi html || exit 1